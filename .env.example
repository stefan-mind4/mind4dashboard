# Supabase-Projekt des Ads Cockpit (bestehendes, produktives Backend).
# Werte aus der Supabase-Console (Project Settings → API) bzw. aus den
# Netlify-Environment-Variablen. Bewusst nicht im Repo — es ist oeffentlich.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# anon-Key — landet im Client-Bundle, ist dafuer gedacht.
# Niemals den service_role-Key hier eintragen.
VITE_SUPABASE_ANON_KEY=
